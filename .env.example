# Copy to .env. audit.py reads this file itself; nothing to source or export.
# Leave a value empty to skip that data source.

# --- Market data (rankings, SERPs, Maps, backlinks, AI Overview citations) ---
# OpenSEO is an open-source, self-hosted SEO data tool (github.com/every-app/open-seo) that
# fronts the DataForSEO API. These two values point at an OpenSEO instance you can reach.
# The values below are Leo's private instance and only work on his network; set your own.
OPENSEO_MCP_URL=https://agi-tools.tailec481c.ts.net/mcp
OPENSEO_PROJECT_ID=a3d9d079-1489-4593-90f3-6cf31d0eb441

# --- Core Web Vitals (optional, free) ---
# Google Cloud Console > enable "PageSpeed Insights API" > create an API key.
PSI_API_KEY=

# --- Live AI-answer checks (optional, paid per query) ---
# perplexity.ai > API. Without it, run the queries by hand and pass --ai-results file.json
PERPLEXITY_API_KEY=
